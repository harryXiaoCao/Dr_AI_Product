# Copy to .env for local development. Never commit real credentials.
DR_AI_ENVIRONMENT=local
DR_AI_API_HOST=127.0.0.1
DR_AI_API_PORT=8000
DR_AI_LOG_LEVEL=INFO
DR_AI_DATABASE_URL=postgresql+psycopg://dr_ai:change-me@127.0.0.1:5432/dr_ai
DR_AI_JWT_SECRET=replace-with-at-least-32-random-characters
DR_AI_JWT_ISSUER=dr-ai-api
DR_AI_JWT_AUDIENCE=dr-ai-app
DR_AI_ACCESS_TOKEN_MINUTES=10
DR_AI_REFRESH_TOKEN_DAYS=14
# Same-origin hosting should leave this empty. For a separate Flutter web host,
# set a JSON array such as ["https://dr-ai-web.example.test"].
DR_AI_CORS_ALLOWED_ORIGINS=[]

# Required only when running `python -m app.seed`. Never commit populated values.
DR_AI_SEED_DOCTOR_PASSWORD=
DR_AI_SEED_PATIENT_PASSWORD=
DR_AI_SEED_UNRELATED_PATIENT_PASSWORD=

# Optional server-side DeepSeek proxy settings. Leave the key empty for local
# safe fallback behavior. Never expose this key to Flutter.
DR_AI_DEEPSEEK_API_KEY=
DR_AI_DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DR_AI_DEEPSEEK_MODEL=deepseek-v4-flash
DR_AI_DEEPSEEK_TIMEOUT_SECONDS=8
DR_AI_CHAT_RATE_LIMIT_MESSAGES=4
DR_AI_CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# Phase 3 is synthetic-only until every real-context approval is recorded.
DR_AI_CHATBOT_DATA_MODE=synthetic_only
DR_AI_CHATBOT_EXTERNAL_PROVIDER_REAL_CONTEXT_ENABLED=false
DR_AI_CHATBOT_EXTERNAL_PROVIDER_DATA_REGION=mainland_china
DR_AI_CHATBOT_EXTERNAL_PROVIDER_ALLOWED_CONTEXT_FIELDS=[]
DR_AI_CHATBOT_EXTERNAL_PROVIDER_NO_TRAINING_CONTRACT_VERIFIED=false
DR_AI_CHATBOT_EXTERNAL_PROVIDER_NO_RETENTION_CONTRACT_VERIFIED=false
DR_AI_CHATBOT_EXTERNAL_PROVIDER_PRIVACY_REVIEW_ID=
DR_AI_CHATBOT_EXTERNAL_PROVIDER_LEGAL_REVIEW_ID=
DR_AI_CHATBOT_EXTERNAL_PROVIDER_PRODUCT_APPROVAL_ID=

# Slice 4 retrieval embeddings. The local baseline is deterministic and suited
# to development/tests only. Production releases should point at the approved
# self-hosted multilingual medical embedding service in Mainland China.
DR_AI_KNOWLEDGE_EMBEDDING_BACKEND=local_baseline
DR_AI_KNOWLEDGE_EMBEDDING_SERVICE_URL=
DR_AI_KNOWLEDGE_EMBEDDING_MODEL=dr-ai-hashed-multilingual-v1
DR_AI_KNOWLEDGE_EMBEDDING_TIMEOUT_SECONDS=3
