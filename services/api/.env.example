# Copy to .env for local development. Never commit real credentials.
DR_AI_ENVIRONMENT=local
DR_AI_API_HOST=127.0.0.1
DR_AI_API_PORT=8000
DR_AI_LOG_LEVEL=INFO
DR_AI_DATABASE_URL=postgresql+psycopg://dr_ai:change-me@127.0.0.1:5432/dr_ai
DR_AI_JWT_SECRET=replace-with-at-least-32-random-characters
DR_AI_JWT_ISSUER=dr-ai-api
DR_AI_JWT_AUDIENCE=dr-ai-app
DR_AI_ACCESS_TOKEN_MINUTES=10
DR_AI_REFRESH_TOKEN_DAYS=14
# Same-origin hosting should leave this empty. For a separate Flutter web host,
# set a JSON array such as ["https://dr-ai-web.example.test"].
DR_AI_CORS_ALLOWED_ORIGINS=[]
# Synthetic imaging bytes use the content-addressed local adapter. The
# tencent_cos boundary is fail-closed until an approved signer is implemented.
DR_AI_IMAGING_STORAGE_BACKEND=local
DR_AI_IMAGING_LOCAL_STORAGE_ROOT=/tmp/dr_ai_synthetic_imaging

# Required only when running `python -m app.seed`. Never commit populated values.
DR_AI_SEED_DOCTOR_PASSWORD=
DR_AI_SEED_PATIENT_PASSWORD=
DR_AI_SEED_UNRELATED_PATIENT_PASSWORD=

# Optional server-side DeepSeek proxy settings. With no key, grounded generation
# returns a fixed provider-unavailable response. Never expose this key to Flutter.
DR_AI_DEEPSEEK_API_KEY=
DR_AI_DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DR_AI_DEEPSEEK_MODEL=deepseek-v4-flash
DR_AI_DEEPSEEK_TIMEOUT_SECONDS=15
DR_AI_CHATBOT_PROVIDER=deepseek
# Generated chatbot answers fail closed unless enabled, un-killed, and backed
# by an exact compatible active release.
DR_AI_CHATBOT_PURPOSE_ENABLED=false
DR_AI_CHATBOT_KILL_SWITCH=true
# Expected-care explanation is a separate purpose. Keep disabled and killed
# for the initial synthetic staging deployment.
DR_AI_EXPECTED_CARE_CANDIDATE_ENABLED=false
DR_AI_EXPECTED_CARE_PROVIDER=deepseek
DR_AI_EXPECTED_CARE_MODEL=deepseek-v4-flash
DR_AI_EXPECTED_CARE_TIMEOUT_SECONDS=15
DR_AI_EXPECTED_CARE_MAX_ATTEMPTS=2
DR_AI_EXPECTED_CARE_MAX_OUTPUT_TOKENS=1200
DR_AI_EXPECTED_CARE_MAX_COST_MICROUNITS=2500
DR_AI_EXPECTED_CARE_EXPLANATION_ENABLED=false
DR_AI_EXPECTED_CARE_EXPLANATION_PROVIDER=deepseek
DR_AI_EXPECTED_CARE_EXPLANATION_MODEL=deepseek-v4-flash
DR_AI_EXPECTED_CARE_EXPLANATION_TIMEOUT_SECONDS=8
DR_AI_EXPECTED_CARE_EXPLANATION_MAX_ATTEMPTS=2
DR_AI_EXPECTED_CARE_EXPLANATION_MAX_OUTPUT_TOKENS=1200
DR_AI_EXPECTED_CARE_EXPLANATION_KILL_SWITCH=true
DR_AI_CHATBOT_GROUNDED_GENERATION_ENABLED=true
DR_AI_CHATBOT_GENERAL_MODEL_KNOWLEDGE_ENABLED=true
DR_AI_CHATBOT_GROUNDED_ANSWER_SCHEMA_VERSION=grounded-answer-v2-2026-07-24
DR_AI_CHATBOT_GENERAL_ANSWER_SCHEMA_VERSION=general-knowledge-v1-2026-07-24
# Slice 9B permits one planner call and at most one retrieval retry.
DR_AI_RETRIEVAL_RESCUE_ENABLED=true
DR_AI_RETRIEVAL_RESCUE_MAX_LATENCY_MS=2500
DR_AI_RETRIEVAL_RESCUE_MAX_COST_MICROUNITS=1000
DR_AI_RETRIEVAL_RESCUE_WEAK_SCORE_THRESHOLD=0.18
DR_AI_DEEPSEEK_INPUT_PRICE_PER_MILLION_USD=0.14
DR_AI_DEEPSEEK_OUTPUT_PRICE_PER_MILLION_USD=0.28
DR_AI_CHAT_RATE_LIMIT_MESSAGES=4
DR_AI_CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# Phase 3 is synthetic-only until every real-context approval is recorded.
DR_AI_CHATBOT_DATA_MODE=synthetic_only
DR_AI_CHATBOT_EXTERNAL_PROVIDER_REAL_CONTEXT_ENABLED=false
DR_AI_CHATBOT_EXTERNAL_PROVIDER_DATA_REGION=mainland_china
DR_AI_CHATBOT_EXTERNAL_PROVIDER_ALLOWED_CONTEXT_FIELDS=[]
DR_AI_CHATBOT_EXTERNAL_PROVIDER_NO_TRAINING_CONTRACT_VERIFIED=false
DR_AI_CHATBOT_EXTERNAL_PROVIDER_NO_RETENTION_CONTRACT_VERIFIED=false
DR_AI_CHATBOT_EXTERNAL_PROVIDER_PRIVACY_REVIEW_ID=
DR_AI_CHATBOT_EXTERNAL_PROVIDER_LEGAL_REVIEW_ID=
DR_AI_CHATBOT_EXTERNAL_PROVIDER_PRODUCT_APPROVAL_ID=

# Slice 9A retrieval ranking. Local baselines are deterministic development/test
# fallbacks only. Production is fail-closed unless both declared models are
# served from the approved self-hosted environment in Mainland China.
DR_AI_KNOWLEDGE_EMBEDDING_BACKEND=local_baseline
DR_AI_KNOWLEDGE_EMBEDDING_SERVICE_URL=
DR_AI_KNOWLEDGE_EMBEDDING_MODEL=dr-ai-hashed-multilingual-v1
DR_AI_KNOWLEDGE_EMBEDDING_TIMEOUT_SECONDS=3
DR_AI_KNOWLEDGE_RERANKER_BACKEND=local_baseline
DR_AI_KNOWLEDGE_RERANKER_SERVICE_URL=
DR_AI_KNOWLEDGE_RERANKER_MODEL=dr-ai-policy-reranker-v5-central-clinical-concepts
DR_AI_KNOWLEDGE_RERANKER_TIMEOUT_SECONDS=3
DR_AI_KNOWLEDGE_MODEL_SERVICE_DATA_REGION=mainland_china

# Locally validated 4-vCPU/8-GB staging candidate. Do not enable these values
# for an existing release: first rebuild every passage embedding and create a
# new immutable release carrying these exact model versions.
# DR_AI_KNOWLEDGE_EMBEDDING_BACKEND=http_service
# DR_AI_KNOWLEDGE_EMBEDDING_SERVICE_URL=http://127.0.0.1:8090/v1/embeddings
# DR_AI_KNOWLEDGE_EMBEDDING_MODEL=Alibaba-NLP/gte-multilingual-base@9bbca17d9273
# DR_AI_KNOWLEDGE_RERANKER_BACKEND=http_service
# DR_AI_KNOWLEDGE_RERANKER_SERVICE_URL=http://127.0.0.1:8090/rerank
# DR_AI_KNOWLEDGE_RERANKER_MODEL=Alibaba-NLP/gte-multilingual-reranker-base@8215cf04918b
