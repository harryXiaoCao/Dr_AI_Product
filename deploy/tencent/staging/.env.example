# Deployment identity
DR_AI_IMAGE=ccr.ccs.tencentyun.com/replace/dr-ai-api@sha256:replace
DR_AI_RETRIEVAL_IMAGE=ccr.ccs.tencentyun.com/replace/dr-ai-retrieval@sha256:replace
DR_AI_STAGING_HOST=replace.example.com

# FastAPI settings
DR_AI_ENVIRONMENT=staging
DR_AI_API_HOST=0.0.0.0
DR_AI_API_PORT=8000
DR_AI_LOG_LEVEL=INFO
DR_AI_DATABASE_URL=postgresql+psycopg://replace
DR_AI_JWT_SECRET=replace
DR_AI_JWT_ISSUER=dr-ai-api
DR_AI_JWT_AUDIENCE=dr-ai-app
DR_AI_ACCESS_TOKEN_MINUTES=10
DR_AI_REFRESH_TOKEN_DAYS=14
DR_AI_CORS_ALLOWED_ORIGINS=[]
DR_AI_KNOWLEDGE_EMBEDDING_BACKEND=http_service
DR_AI_KNOWLEDGE_EMBEDDING_SERVICE_URL=http://retrieval_models:8090/v1/embeddings
DR_AI_KNOWLEDGE_EMBEDDING_MODEL=Alibaba-NLP/gte-multilingual-base@9bbca17d9273
DR_AI_KNOWLEDGE_EMBEDDING_TIMEOUT_SECONDS=8
DR_AI_KNOWLEDGE_RERANKER_BACKEND=http_service
DR_AI_KNOWLEDGE_RERANKER_SERVICE_URL=http://retrieval_models:8090/rerank
DR_AI_KNOWLEDGE_RERANKER_MODEL=Alibaba-NLP/gte-multilingual-reranker-base@8215cf04918b
DR_AI_KNOWLEDGE_RERANKER_TIMEOUT_SECONDS=8
DR_AI_KNOWLEDGE_RERANKER_MAX_CANDIDATES=4
DR_AI_KNOWLEDGE_MODEL_SERVICE_DATA_REGION=hong_kong
DR_AI_DOCTOR_INVITE_CODE=
DR_AI_PATIENT_INVITE_CODE=
DR_AI_SEED_DOCTOR_PASSWORD=
DR_AI_SEED_PATIENT_PASSWORD=
