# Deployment identity
DR_AI_IMAGE=ccr.ccs.tencentyun.com/replace/dr-ai-api@sha256:replace
DR_AI_RETRIEVAL_IMAGE=ccr.ccs.tencentyun.com/replace/dr-ai-retrieval@sha256:replace
DR_AI_STAGING_HOST=replace.example.com

# FastAPI settings
DR_AI_ENVIRONMENT=staging
DR_AI_API_HOST=0.0.0.0
DR_AI_API_PORT=8000
DR_AI_LOG_LEVEL=INFO
DR_AI_DEPLOYMENT_SOURCE_REVISION=unrecorded
DR_AI_DEPLOYMENT_IMAGE_DIGEST=unrecorded
DR_AI_DEPLOYMENT_WEB_SHA256=unrecorded
DR_AI_DATABASE_URL=postgresql+psycopg://replace
DR_AI_JWT_SECRET=replace
DR_AI_JWT_ISSUER=dr-ai-api
DR_AI_JWT_AUDIENCE=dr-ai-app
DR_AI_ACCESS_TOKEN_MINUTES=10
DR_AI_REFRESH_TOKEN_DAYS=14
DR_AI_CORS_ALLOWED_ORIGINS=[]
# Staging remains synthetic/local. Selecting tencent_cos fails closed because
# this repository does not contain an approved live COS signer or write path.
DR_AI_IMAGING_STORAGE_BACKEND=local
DR_AI_IMAGING_LOCAL_STORAGE_ROOT=/tmp/dr_ai_synthetic_imaging

# Phase 6 external notification delivery is fail-closed in controlled staging.
# Provider credentials belong only in the host's mode-0600 .env or an approved
# secret manager. An empty credential is unavailable, never a successful send.
DR_AI_NOTIFICATION_EXTERNAL_DELIVERY_ENABLED=false
DR_AI_NOTIFICATION_WORKER_ENABLED=false
DR_AI_NOTIFICATION_APNS_TEAM_ID=
DR_AI_NOTIFICATION_APNS_KEY_ID=
DR_AI_NOTIFICATION_APNS_BUNDLE_ID=
DR_AI_NOTIFICATION_APNS_PRIVATE_KEY=
DR_AI_NOTIFICATION_EMAS_APP_KEY=
DR_AI_NOTIFICATION_EMAS_APP_SECRET=
DR_AI_NOTIFICATION_EMAS_ANDROID_PACKAGE=
DR_AI_NOTIFICATION_EMAS_OEM_APPROVALS_VERIFIED=false
DR_AI_NOTIFICATION_WEB_PUSH_VAPID_PUBLIC_KEY=
DR_AI_NOTIFICATION_WEB_PUSH_VAPID_PRIVATE_KEY=
DR_AI_NOTIFICATION_WEB_PUSH_SUBJECT=

DR_AI_DEEPSEEK_API_KEY=
DR_AI_DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DR_AI_DEEPSEEK_MODEL=deepseek-v4-flash
DR_AI_DEEPSEEK_TIMEOUT_SECONDS=15
DR_AI_CHATBOT_PROVIDER=deepseek
DR_AI_CHATBOT_PURPOSE_ENABLED=false
DR_AI_CHATBOT_KILL_SWITCH=true
DR_AI_EXPECTED_CARE_CANDIDATE_ENABLED=false
DR_AI_EXPECTED_CARE_PROVIDER=deepseek
DR_AI_EXPECTED_CARE_MODEL=deepseek-v4-flash
DR_AI_EXPECTED_CARE_TIMEOUT_SECONDS=15
DR_AI_EXPECTED_CARE_MAX_ATTEMPTS=2
DR_AI_EXPECTED_CARE_MAX_OUTPUT_TOKENS=1200
DR_AI_EXPECTED_CARE_MAX_COST_MICROUNITS=2500
DR_AI_EXPECTED_CARE_EXPLANATION_ENABLED=false
DR_AI_EXPECTED_CARE_EXPLANATION_KILL_SWITCH=true
DR_AI_EXPECTED_CARE_EXPLANATION_PROVIDER=deepseek
DR_AI_EXPECTED_CARE_EXPLANATION_MODEL=deepseek-v4-flash
DR_AI_EXPECTED_CARE_EXPLANATION_TIMEOUT_SECONDS=8
DR_AI_EXPECTED_CARE_EXPLANATION_MAX_ATTEMPTS=2
DR_AI_EXPECTED_CARE_EXPLANATION_MAX_OUTPUT_TOKENS=1200
DR_AI_KNOWLEDGE_EMBEDDING_BACKEND=http_service
DR_AI_KNOWLEDGE_EMBEDDING_SERVICE_URL=http://retrieval_models:8090/v1/embeddings
DR_AI_KNOWLEDGE_EMBEDDING_MODEL=Alibaba-NLP/gte-multilingual-base@9bbca17d9273
DR_AI_KNOWLEDGE_EMBEDDING_TIMEOUT_SECONDS=8
DR_AI_KNOWLEDGE_RERANKER_BACKEND=http_service
DR_AI_KNOWLEDGE_RERANKER_SERVICE_URL=http://retrieval_models:8090/rerank
DR_AI_KNOWLEDGE_RERANKER_MODEL=Alibaba-NLP/gte-multilingual-reranker-base@8215cf04918b
DR_AI_KNOWLEDGE_RERANKER_TIMEOUT_SECONDS=8
DR_AI_KNOWLEDGE_RERANKER_MAX_CANDIDATES=4
DR_AI_KNOWLEDGE_MODEL_SERVICE_DATA_REGION=hong_kong
DR_AI_DOCTOR_INVITE_CODE=
DR_AI_PATIENT_INVITE_CODE=
DR_AI_SEED_DOCTOR_PASSWORD=
DR_AI_SEED_PATIENT_PASSWORD=
DR_AI_SEED_UNRELATED_PATIENT_PASSWORD=
DR_AI_SEED_PAYER_PASSWORD=
