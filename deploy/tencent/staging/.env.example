# Deployment identity
DR_AI_IMAGE=ccr.ccs.tencentyun.com/replace/dr-ai-api@sha256:replace
DR_AI_STAGING_HOST=replace.example.com

# FastAPI settings
DR_AI_ENVIRONMENT=staging
DR_AI_API_HOST=0.0.0.0
DR_AI_API_PORT=8000
DR_AI_LOG_LEVEL=INFO
DR_AI_DATABASE_URL=postgresql+psycopg://replace
DR_AI_JWT_SECRET=replace
DR_AI_JWT_ISSUER=dr-ai-api
DR_AI_JWT_AUDIENCE=dr-ai-app
DR_AI_ACCESS_TOKEN_MINUTES=10
DR_AI_REFRESH_TOKEN_DAYS=14
DR_AI_DOCTOR_INVITE_CODE=
DR_AI_PATIENT_INVITE_CODE=
DR_AI_SEED_DOCTOR_PASSWORD=
DR_AI_SEED_PATIENT_PASSWORD=
DR_AI_SEED_UNRELATED_PATIENT_PASSWORD=
